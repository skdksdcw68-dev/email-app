<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Push. "production" because every build that reaches a device comes
	     through TestFlight, which uses the production APNs environment.
	     A build signed for "development" gets a sandbox device token, and
	     sending it to the production APNs host fails with BadDeviceToken --
	     a mismatch that reads like a broken token rather than a wrong host.
	     The provisioning profile regenerated on 2026-09-01 carries the
	     matching aps-environment, so this signs. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Shared with MailyNotify, the notification service extension, which
	     needs the mailbox's refresh grant to fetch the sender and subject
	     before the banner is drawn. See `PushCredentials`.

	     Adding a group does NOT move anything already stored: the app keeps
	     its default group as well, so `Keychain` and the GoogleSignIn SDK go
	     on reading exactly what they wrote. Only the new push record is
	     written into the shared group, and only because two targets have to
	     reach it. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.netro.maily</string>
		<string>$(AppIdentifierPrefix)com.netro.maily.shared</string>
	</array>
</dict>
</plist>
