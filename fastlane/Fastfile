default_platform(:ios)

BUNDLE_ID = "emailapptest"
XCODEPROJ  = "EmailApp.xcodeproj"
SCHEME     = "EmailApp"

platform :ios do
  desc "Build and upload a new build to TestFlight. The Xcode project is " \
       "generated by XcodeGen in an earlier CI step, not here."
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    # readonly: false so the very first run can create the distribution
    # certificate + provisioning profile itself -- no Mac ever needed to do
    # this by hand. Safe to leave permanently: match is a no-op once the
    # stored certs already match the Developer Portal.
    match(
      type: "appstore",
      api_key: api_key,
      readonly: false,
      # Import into the dedicated CI keychain the workflow creates (with a
      # password we control), not the default login keychain -- without a
      # known password macOS cannot grant codesign silent access, and every
      # signature hangs on a permission prompt no one can click.
      keychain_name: "ci.keychain",
      keychain_password: ENV["KEYCHAIN_PASSWORD"]
    )

    # Read the REAL profile name match returns rather than hardcoding
    # "match AppStore emailapptest". Apple appends a numeric suffix whenever
    # a profile with that exact name already exists on the portal, and a
    # hardcoded name breaks the moment that happens ("No profile found").
    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][BUNDLE_ID]

    # XcodeGen writes CODE_SIGN_STYLE: Manual but no team or profile -- it
    # cannot know them. This points the freshly generated project at the
    # exact cert and profile match just installed.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: BUNDLE_ID
    )

    # GITHUB_RUN_NUMBER strictly increases per workflow run, which is all
    # App Store Connect requires. Note: re-running the SAME failed run keeps
    # the number -- if that build already reached ASC, bump MARKETING_VERSION
    # in project.yml instead of just re-running.
    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: XCODEPROJ
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          BUNDLE_ID => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
